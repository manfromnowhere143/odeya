{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odeya:schema:event-contract-record:0.1.0",
  "title": "Odeya Event Contract Record",
  "description": "Closed standalone product schema for one event contract record. This successor preserves the exact transitive contract of the event member formerly embedded in its registry while assigning the record its own schema identity and digest domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "member_key",
    "event_type",
    "event_version",
    "payload_contract",
    "aggregate_owner",
    "producer_commands",
    "retention_and_privacy",
    "canonical_reducer_ref",
    "trace_refs",
    "review_evidence_refs",
    "member_digest_contract",
    "member_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "member_key": {
      "$ref": "#/$defs/member_key"
    },
    "event_type": {
      "$ref": "#/$defs/identifier"
    },
    "event_version": {
      "$ref": "#/$defs/semantic_version"
    },
    "payload_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_envelope_schema_ref",
        "payload_json_pointer",
        "payload_required",
        "nullable",
        "exact_branch_required"
      ],
      "properties": {
        "event_envelope_schema_ref": {
          "$ref": "#/$defs/event_contract_registry_schema_bytes_reference"
        },
        "payload_json_pointer": {
          "$ref": "#/$defs/json_pointer"
        },
        "payload_required": {
          "const": true
        },
        "nullable": {
          "const": false
        },
        "exact_branch_required": {
          "const": true
        }
      }
    },
    "aggregate_owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owning_module",
        "aggregate_type",
        "ownership_cardinality"
      ],
      "properties": {
        "owning_module": {
          "$ref": "#/$defs/identifier"
        },
        "aggregate_type": {
          "$ref": "#/$defs/identifier"
        },
        "ownership_cardinality": {
          "const": "exactly_one"
        }
      }
    },
    "producer_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/command_member_reference"
      }
    },
    "retention_and_privacy": {
      "$ref": "#/$defs/retention_privacy_contract"
    },
    "canonical_reducer_ref": {
      "$ref": "#/$defs/event_contract_registry_reducer_member_reference"
    },
    "trace_refs": {
      "$ref": "#/$defs/event_contract_registry_nonempty_artifact_array"
    },
    "review_evidence_refs": {
      "$ref": "#/$defs/event_contract_registry_nonempty_artifact_array"
    },
    "member_digest_contract": {
      "$ref": "#/$defs/event_member_digest_contract"
    },
    "member_digest": {
      "$ref": "#/$defs/digest",
      "x-odeya-digest-scope": {
        "kind": "canonical_object_digest",
        "domain": "odeya-event-contract-record-v1",
        "algorithm": "sha-256",
        "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
        "status": "candidate_unissued_domain"
      }
    }
  },
  "$defs": {
    "member_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "event_contract_registry_schema_bytes_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_member_key",
        "schema_id",
        "semantic_version",
        "byte_digest",
        "byte_count",
        "dialect",
        "root_json_type",
        "schema_member_digest"
      ],
      "properties": {
        "schema_member_key": {
          "$ref": "#/$defs/member_key"
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "semantic_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "byte_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained raw bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "byte_count": {
          "type": "integer",
          "minimum": 2
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "root_json_type": {
          "const": "object"
        },
        "schema_member_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "canonical_object_digest",
            "domain": "odeya-schema-resource-record-v1",
            "algorithm": "sha-256",
            "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
            "status": "candidate_unissued_domain"
          }
        }
      }
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^/(\\$defs|properties)(/([^~/]|~0|~1)+)+$"
    },
    "command_member_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command_type",
        "command_version",
        "reference_kind",
        "resolution_requirement"
      ],
      "properties": {
        "command_type": {
          "$ref": "#/$defs/identifier"
        },
        "command_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "reference_kind": {
          "const": "logical_reverse_reference"
        },
        "resolution_requirement": {
          "const": "future_same_root_exact_member"
        }
      }
    },
    "retention_privacy_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "retention_class",
        "minimum_retention",
        "legal_hold_overrides_destruction",
        "privacy_class",
        "payload_logging",
        "projection_redaction_required"
      ],
      "properties": {
        "retention_class": {
          "enum": [
            "constitutional_permanent",
            "scientific_record",
            "operational_audit",
            "privacy_bounded"
          ]
        },
        "minimum_retention": {
          "enum": [
            "permanent",
            "mission_plus_policy",
            "policy_bounded"
          ]
        },
        "legal_hold_overrides_destruction": {
          "const": true
        },
        "privacy_class": {
          "enum": [
            "public",
            "internal",
            "restricted",
            "sensitive",
            "highly_sensitive"
          ]
        },
        "payload_logging": {
          "enum": [
            "full_canonical_only",
            "redacted_canonical",
            "metadata_only"
          ]
        },
        "projection_redaction_required": {
          "type": "boolean"
        }
      }
    },
    "event_contract_registry_reducer_member_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_type",
        "reducer_id",
        "reducer_version",
        "reducer_member_digest"
      ],
      "properties": {
        "aggregate_type": {
          "$ref": "#/$defs/identifier"
        },
        "reducer_id": {
          "$ref": "#/$defs/identifier"
        },
        "reducer_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "reducer_member_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "canonical_object_digest",
            "domain": "odeya-reducer-contract-record-v1",
            "algorithm": "sha-256",
            "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
            "status": "candidate_unissued_domain"
          }
        }
      }
    },
    "event_contract_registry_nonempty_artifact_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event_contract_registry_artifact_reference"
      }
    },
    "event_member_digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "subject_schema_ref",
        "included_json_pointers",
        "excluded_json_pointers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "domain_separator": {
          "const": "odeya-event-contract-record-v1"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "subject_schema_ref": {
          "$ref": "#/$defs/event_contract_record_schema_reference"
        },
        "included_json_pointers": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "prefixItems": [
            {
              "const": "/schema_version"
            },
            {
              "const": "/member_key"
            },
            {
              "const": "/event_type"
            },
            {
              "const": "/event_version"
            },
            {
              "const": "/payload_contract"
            },
            {
              "const": "/aggregate_owner"
            },
            {
              "const": "/producer_commands"
            },
            {
              "const": "/retention_and_privacy"
            },
            {
              "const": "/canonical_reducer_ref"
            },
            {
              "const": "/member_digest_contract"
            }
          ],
          "items": false
        },
        "excluded_json_pointers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "/trace_refs"
            },
            {
              "const": "/review_evidence_refs"
            },
            {
              "const": "/member_digest"
            }
          ],
          "items": false
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "event_contract_registry_artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained artifact or profile document bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_core_schema_id",
        "profile_core_raw_digest"
      ],
      "properties": {
        "profile_id": {
          "const": "urn:odeya:canonicalization:odeya-jcs-0.2"
        },
        "profile_version": {
          "const": "0.2.0"
        },
        "profile_core_schema_id": {
          "const": "urn:odeya:schema:canonicalization-profile-core:0.6.0"
        },
        "profile_core_raw_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained canonicalization profile core bytes named by sibling profile identity and schema identity",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    },
    "event_contract_record_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:schema:event-contract-record:0.1.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained schema resource bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        }
      }
    }
  }
}
