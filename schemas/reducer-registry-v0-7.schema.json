{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odeya:schema:reducer-registry:0.7.0",
  "title": "Odeya Reducer Registry",
  "description": "Closed side-by-side registry successor whose identity commits only to a homogeneous leaf map of member keys and member digests. It contains no member bodies, admission or membership proof, registry history, checkpoint, currentness claim, signature, external action binding, or activation state.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_kind",
    "registry_id",
    "version",
    "supersedes_registry_subject_ref",
    "canonicalization_profile_ref",
    "member_record_schema_ref",
    "member_set_commitment",
    "registry_digest_contract",
    "registry_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.7.0"
    },
    "registry_kind": {
      "const": "reducer_registry"
    },
    "registry_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/semantic_version"
    },
    "supersedes_registry_subject_ref": {
      "type": "null"
    },
    "canonicalization_profile_ref": {
      "$ref": "#/$defs/profile_reference"
    },
    "member_record_schema_ref": {
      "$ref": "#/$defs/reducer_registry_member_record_schema_reference"
    },
    "member_set_commitment": {
      "allOf": [
        {
          "$ref": "urn:odeya:schema:ordered-member-map-commitment:0.1.0"
        },
        {
          "properties": {
            "registry_family": {
              "const": "reducer_registry"
            },
            "ordered_members": {
              "maxItems": 256
            }
          }
        }
      ]
    },
    "registry_digest_contract": {
      "$ref": "#/$defs/reducer_registry_digest_contract"
    },
    "registry_digest": {
      "$ref": "#/$defs/digest",
      "x-odeya-digest-scope": {
        "kind": "canonical_object_digest",
        "domain": "odeya-reducer-registry-v2",
        "algorithm": "sha-256",
        "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
        "status": "candidate_unissued_domain"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_core_schema_id",
        "profile_core_raw_digest"
      ],
      "properties": {
        "profile_id": {
          "const": "urn:odeya:canonicalization:odeya-jcs-0.2"
        },
        "profile_version": {
          "const": "0.2.0"
        },
        "profile_core_schema_id": {
          "const": "urn:odeya:schema:canonicalization-profile-core:0.6.0"
        },
        "profile_core_raw_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained canonicalization profile core bytes named by sibling profile identity and schema identity",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    },
    "reducer_registry_member_record_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:schema:reducer-contract-record:0.1.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained schema resource bytes named by sibling schema_id",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    },
    "reducer_registry_digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "subject_schema_ref",
        "included_json_pointers",
        "excluded_json_pointers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "domain_separator": {
          "const": "odeya-reducer-registry-v2"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "subject_schema_ref": {
          "$ref": "#/$defs/reducer_registry_subject_schema_reference"
        },
        "included_json_pointers": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "prefixItems": [
            {
              "const": "/schema_version"
            },
            {
              "const": "/registry_kind"
            },
            {
              "const": "/registry_id"
            },
            {
              "const": "/version"
            },
            {
              "const": "/supersedes_registry_subject_ref"
            },
            {
              "const": "/canonicalization_profile_ref"
            },
            {
              "const": "/member_record_schema_ref"
            },
            {
              "const": "/member_set_commitment"
            },
            {
              "const": "/registry_digest_contract"
            }
          ],
          "items": false
        },
        "excluded_json_pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "const": "/registry_digest"
            }
          ],
          "items": false
        }
      }
    },
    "reducer_registry_subject_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:schema:reducer-registry:0.7.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained schema resource bytes named by sibling schema_id",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    }
  }
}
