{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odeya:schema:aggregate-state-subject-record:0.1.0",
  "title": "Odeya Aggregate State Subject Record",
  "description": "Closed standalone product schema for one aggregate state-subject record. This successor preserves the exact transitive contract of the state-subject member formerly embedded in its registry while assigning the record its own schema identity and digest domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "aggregate_type",
    "state_subject_id",
    "state_subject_version",
    "owning_module",
    "state_schema_ref",
    "canonical_reducer_ref",
    "origin_contract",
    "version_and_head_contract",
    "state_root_contract",
    "failure_semantics",
    "invariant_rule_refs",
    "trace_refs",
    "review_evidence_refs",
    "member_digest_contract",
    "member_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "aggregate_type": {
      "$ref": "#/$defs/identifier"
    },
    "state_subject_id": {
      "$ref": "#/$defs/identifier"
    },
    "state_subject_version": {
      "$ref": "#/$defs/semantic_version"
    },
    "owning_module": {
      "$ref": "#/$defs/identifier"
    },
    "state_schema_ref": {
      "$ref": "#/$defs/aggregate_state_subject_registry_schema_bytes_reference"
    },
    "canonical_reducer_ref": {
      "$ref": "#/$defs/reducer_member_reference"
    },
    "origin_contract": {
      "$ref": "#/$defs/origin_contract"
    },
    "version_and_head_contract": {
      "$ref": "#/$defs/version_and_head_contract"
    },
    "state_root_contract": {
      "$ref": "#/$defs/state_root_contract"
    },
    "failure_semantics": {
      "$ref": "#/$defs/failure_semantics"
    },
    "invariant_rule_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/rule_reference"
      }
    },
    "trace_refs": {
      "$ref": "#/$defs/aggregate_state_subject_registry_nonempty_artifact_array"
    },
    "review_evidence_refs": {
      "$ref": "#/$defs/aggregate_state_subject_registry_nonempty_artifact_array"
    },
    "member_digest_contract": {
      "$ref": "#/$defs/state_member_digest_contract"
    },
    "member_digest": {
      "$ref": "#/$defs/digest",
      "x-odeya-digest-scope": {
        "kind": "canonical_object_digest",
        "domain": "odeya-aggregate-state-subject-record-v1",
        "algorithm": "sha-256",
        "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
        "status": "candidate_unissued_domain"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "aggregate_state_subject_registry_schema_bytes_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_member_key",
        "schema_id",
        "semantic_version",
        "byte_digest",
        "byte_count",
        "dialect",
        "root_json_type",
        "schema_member_digest"
      ],
      "properties": {
        "schema_member_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,191}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        },
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "semantic_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "byte_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained raw bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "byte_count": {
          "type": "integer",
          "minimum": 2
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "root_json_type": {
          "const": "object"
        },
        "schema_member_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "canonical_object_digest",
            "domain": "odeya-schema-resource-record-v1",
            "algorithm": "sha-256",
            "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
            "status": "candidate_unissued_domain"
          }
        }
      }
    },
    "reducer_member_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregate_type",
        "reducer_id",
        "reducer_version",
        "reference_kind",
        "resolution_requirement"
      ],
      "properties": {
        "aggregate_type": {
          "$ref": "#/$defs/identifier"
        },
        "reducer_id": {
          "$ref": "#/$defs/identifier"
        },
        "reducer_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "reference_kind": {
          "const": "logical_reverse_reference"
        },
        "resolution_requirement": {
          "const": "future_same_root_exact_member"
        }
      }
    },
    "origin_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pre_origin_representation",
        "absence_is_state",
        "origin_event_refs",
        "first_materialized_version",
        "fabricated_v0_state",
        "origin_state_is_reducer_output",
        "origin_from_snapshot"
      ],
      "properties": {
        "pre_origin_representation": {
          "const": "aggregate_absent"
        },
        "absence_is_state": {
          "const": false
        },
        "origin_event_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/event_member_reference"
          }
        },
        "first_materialized_version": {
          "const": 1
        },
        "fabricated_v0_state": {
          "const": "forbidden"
        },
        "origin_state_is_reducer_output": {
          "const": true
        },
        "origin_from_snapshot": {
          "const": false
        }
      }
    },
    "version_and_head_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_origin",
        "version_increment_per_accepted_event",
        "head_fields",
        "gap_duplicate_or_reorder",
        "wall_clock_in_identity"
      ],
      "properties": {
        "version_origin": {
          "const": 1
        },
        "version_increment_per_accepted_event": {
          "const": 1
        },
        "head_fields": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "event_id"
            },
            {
              "const": "stream_position"
            },
            {
              "const": "aggregate_version"
            },
            {
              "const": "event_digest"
            }
          ],
          "items": false
        },
        "gap_duplicate_or_reorder": {
          "const": "block"
        },
        "wall_clock_in_identity": {
          "const": false
        }
      }
    },
    "state_root_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "included_components",
        "excluded_components",
        "missing_component"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "domain_separator": {
          "type": "string",
          "pattern": "^odeya-[a-z0-9-]+-state-root-v[1-9][0-9]*$"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "included_components": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "const": "aggregate_identity"
            },
            {
              "const": "aggregate_version"
            },
            {
              "const": "state_schema_bytes_identity"
            },
            {
              "const": "canonical_reducer_identity"
            },
            {
              "const": "event_head_identity"
            },
            {
              "const": "canonical_state_bytes"
            }
          ],
          "items": false
        },
        "excluded_components": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            {
              "const": "snapshot_location"
            },
            {
              "const": "checkpoint_reference"
            },
            {
              "const": "activation_reference"
            },
            {
              "const": "signatures"
            }
          ],
          "items": false
        },
        "missing_component": {
          "const": "block"
        }
      }
    },
    "failure_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "missing_schema_bytes",
        "missing_reducer",
        "broken_head",
        "invalid_state_bytes",
        "unknown_major_version",
        "invariant_failure",
        "snapshot_mismatch"
      ],
      "properties": {
        "missing_schema_bytes": {
          "const": "block"
        },
        "missing_reducer": {
          "const": "block"
        },
        "broken_head": {
          "const": "block"
        },
        "invalid_state_bytes": {
          "const": "block"
        },
        "unknown_major_version": {
          "const": "block"
        },
        "invariant_failure": {
          "const": "block"
        },
        "snapshot_mismatch": {
          "const": "discard_snapshot_and_replay_or_quarantine"
        }
      }
    },
    "rule_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "version",
        "rule_digest"
      ],
      "properties": {
        "rule_id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/semantic_version"
        },
        "rule_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "canonical_object_digest",
            "domain": "odeya-rule-record-v1",
            "algorithm": "sha-256",
            "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
            "status": "prospective_domain_reserved_not_declared"
          }
        }
      }
    },
    "aggregate_state_subject_registry_nonempty_artifact_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/aggregate_state_subject_registry_artifact_reference"
      }
    },
    "state_member_digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "subject_schema_ref",
        "included_json_pointers",
        "excluded_json_pointers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "domain_separator": {
          "const": "odeya-aggregate-state-subject-record-v1"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "subject_schema_ref": {
          "$ref": "#/$defs/aggregate_state_subject_record_schema_reference"
        },
        "included_json_pointers": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "const": "/schema_version"
            },
            {
              "const": "/aggregate_type"
            },
            {
              "const": "/state_subject_id"
            },
            {
              "const": "/state_subject_version"
            },
            {
              "const": "/owning_module"
            },
            {
              "const": "/state_schema_ref"
            },
            {
              "const": "/canonical_reducer_ref"
            },
            {
              "const": "/origin_contract"
            },
            {
              "const": "/version_and_head_contract"
            },
            {
              "const": "/state_root_contract"
            },
            {
              "const": "/failure_semantics"
            },
            {
              "const": "/invariant_rule_refs"
            },
            {
              "const": "/member_digest_contract"
            }
          ],
          "items": false
        },
        "excluded_json_pointers": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "prefixItems": [
            {
              "const": "/trace_refs"
            },
            {
              "const": "/review_evidence_refs"
            },
            {
              "const": "/member_digest"
            }
          ],
          "items": false
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "event_member_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "event_version",
        "reference_kind",
        "resolution_requirement"
      ],
      "properties": {
        "event_type": {
          "$ref": "#/$defs/identifier"
        },
        "event_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "reference_kind": {
          "const": "logical_reverse_reference"
        },
        "resolution_requirement": {
          "const": "future_same_root_exact_member"
        }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_core_schema_id",
        "profile_core_raw_digest"
      ],
      "properties": {
        "profile_id": {
          "const": "urn:odeya:canonicalization:odeya-jcs-0.2"
        },
        "profile_version": {
          "const": "0.2.0"
        },
        "profile_core_schema_id": {
          "const": "urn:odeya:schema:canonicalization-profile-core:0.6.0"
        },
        "profile_core_raw_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained canonicalization profile core bytes named by sibling profile identity and schema identity",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    },
    "aggregate_state_subject_registry_artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained artifact or profile document bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      }
    },
    "aggregate_state_subject_record_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:schema:aggregate-state-subject-record:0.1.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained schema resource bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        }
      }
    }
  }
}
