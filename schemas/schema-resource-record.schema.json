{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odeya:schema:schema-resource-record:0.1.0",
  "title": "Odeya Schema Resource Record",
  "description": "Closed standalone product schema for one content-addressed schema resource record. This successor preserves the exact transitive contract of the schema member formerly embedded in the schema registry while assigning the record its own schema identity and digest domain.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "member_key",
    "schema_bytes",
    "compatibility_contract",
    "conformance_vector_refs",
    "member_digest_contract",
    "member_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "member_key": {
      "$ref": "#/$defs/member_key"
    },
    "schema_bytes": {
      "$ref": "#/$defs/schema_bytes_identity"
    },
    "compatibility_contract": {
      "$ref": "#/$defs/compatibility_contract"
    },
    "conformance_vector_refs": {
      "$ref": "#/$defs/schema_registry_nonempty_artifact_array"
    },
    "member_digest_contract": {
      "$ref": "#/$defs/schema_member_digest_contract"
    },
    "member_digest": {
      "$ref": "#/$defs/digest",
      "x-odeya-digest-scope": {
        "kind": "canonical_object_digest",
        "domain": "odeya-schema-resource-record-v1",
        "algorithm": "sha-256",
        "profile": "urn:odeya:canonicalization:odeya-jcs-0.2",
        "status": "candidate_unissued_domain"
      }
    }
  },
  "$defs": {
    "member_key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schema_bytes_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "semantic_version",
        "byte_digest",
        "byte_count",
        "media_type",
        "encoding",
        "dialect",
        "root_json_type",
        "retrieval"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "format": "uri"
        },
        "semantic_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "byte_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained raw bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "byte_count": {
          "type": "integer",
          "minimum": 2
        },
        "media_type": {
          "const": "application/schema+json"
        },
        "encoding": {
          "const": "utf-8"
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "root_json_type": {
          "enum": [
            "object",
            "array",
            "string",
            "number",
            "integer",
            "boolean",
            "null",
            "union"
          ]
        },
        "retrieval": {
          "const": "content_addressed_retained_raw_bytes"
        }
      }
    },
    "compatibility_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reader_mode",
        "unknown_major_version",
        "implicit_upcast",
        "canonical_bytes_rewrite"
      ],
      "properties": {
        "reader_mode": {
          "enum": [
            "exact_version_only",
            "explicit_registered_upcast_only"
          ]
        },
        "unknown_major_version": {
          "const": "block"
        },
        "implicit_upcast": {
          "const": false
        },
        "canonical_bytes_rewrite": {
          "const": "forbidden"
        }
      }
    },
    "schema_registry_nonempty_artifact_array": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/schema_registry_artifact_reference"
      }
    },
    "schema_member_digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "subject_schema_ref",
        "included_json_pointers",
        "excluded_json_pointers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha-256"
        },
        "domain_separator": {
          "const": "odeya-schema-resource-record-v1"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "subject_schema_ref": {
          "$ref": "#/$defs/schema_resource_record_schema_reference"
        },
        "included_json_pointers": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "prefixItems": [
            {
              "const": "/schema_version"
            },
            {
              "const": "/member_key"
            },
            {
              "const": "/schema_bytes"
            },
            {
              "const": "/compatibility_contract"
            },
            {
              "const": "/member_digest_contract"
            }
          ],
          "items": false
        },
        "excluded_json_pointers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "const": "/conformance_vector_refs"
            },
            {
              "const": "/member_digest"
            }
          ],
          "items": false
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schema_registry_artifact_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "media_type"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/identifier"
        },
        "digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained artifact or profile document bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 127
        }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_core_schema_id",
        "profile_core_raw_digest"
      ],
      "properties": {
        "profile_id": {
          "const": "urn:odeya:canonicalization:odeya-jcs-0.2"
        },
        "profile_version": {
          "const": "0.2.0"
        },
        "profile_core_schema_id": {
          "const": "urn:odeya:schema:canonicalization-profile-core:0.6.0"
        },
        "profile_core_raw_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact retained canonicalization profile core bytes named by sibling profile identity and schema identity",
            "algorithm": "sha-256",
            "profile": "raw_bytes_no_canonicalization",
            "status": "candidate_unissued_exact_raw_byte_binding"
          }
        }
      }
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{1,127}$"
    },
    "schema_resource_record_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:schema:schema-resource-record:0.1.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "retained schema resource bytes",
            "algorithm": "sha-256",
            "profile": "not_a_canonical_object_digest",
            "status": "accepted_disposition_annotation"
          }
        }
      }
    }
  }
}
