      "properties": {
        "classification_point": {
          "const": "after_utf8_and_json_lexing_before_mapping_or_schema_type_evaluation"
        },
        "json_number_grammar": {
          "const": "RFC8259_number"
        },
        "integer_token_pattern": {
          "const": "^-?(?:0|[1-9][0-9]*)$"
        },
        "number_token_definition": {
          "const": "valid_json_number_token_containing_fraction_or_exponent"
        },
        "max_number_token_bytes_decimal": {
          "const": "128"
        },
        "lexical_negative_zero_definition": {
          "const": "reject_token_with_negative_sign_and_exact_zero_decimal_significand_before_host_conversion"
        },
        "nonfinite_conversion": {
          "const": "reject_valid_json_number_token_whose_binary64_conversion_is_not_finite"
        },
        "underflow_conversion": {
          "const": "reject_exact_nonzero_decimal_token_whose_binary64_conversion_is_positive_or_negative_zero"
        },
        "metadata_retention": {
          "const": "retain_raw_lexeme_token_class_and_unique_instance_pointer_in_validation_sidecar_until_projection_construction"
        },
        "metadata_projection_disposition": {
          "const": "validation_sidecar_metadata_is_not_inserted_into_projection_or_digest_preimage"
        },
        "ieee754_conversion": {
          "const": "finite_binary64_required_before_rfc8785_serialization"
        }
      }
    },
