{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "urn:odeya:architecture:prq-002f-numeric-trace-conformance-contract:0.1.0",
 "title": "PRQ-002F numeric trace conformance contract",
 "description": "Closed architecture-only contract for the bounded two-implementation raw-aware numeric-trace and cross-object conformance observation over the exact fifteen frozen odeya-jcs-0.3 construction subjects. This contract is architecture evidence, not a product schema, profile issuance, admission, PRQ-002 closure, Gate A acceptance, or authority.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "schema_version",
  "artifact_class",
  "contract_id",
  "status",
  "decision_ref",
  "predecessor_checkpoint",
  "profile_id",
  "raw_number_contract_id",
  "subject_count_decimal",
  "schema_document_subject_count_decimal",
  "record_instance_subject_count_decimal",
  "subjects",
  "closed_schema_vocabulary",
  "final_position_rule_precedence",
  "schema_document_token_rule",
  "metaschema_evaluation_disposition",
  "integer_safe_range",
  "refusal_codes",
  "implementation_requirements",
  "claim_boundary"
 ],
 "properties": {
  "schema_version": {"const": "0.1.0"},
  "artifact_class": {"const": "prq_002f_numeric_trace_conformance_contract"},
  "contract_id": {"const": "prq-002f-numeric-trace-conformance-contract.0001"},
  "status": {"const": "architecture_only_bounded_trace_and_conformance_observation"},
  "decision_ref": {"const": "docs/decisions/0106-prove-raw-aware-numeric-trace-conformance-for-the-0-3-cohort.md"},
  "predecessor_checkpoint": {
   "type": "object",
   "additionalProperties": false,
   "required": ["commit", "tree"],
   "properties": {
    "commit": {"const": "1c6fb114b71ca4e095389b33869d5faf2bd7c65a"},
    "tree": {"const": "066b9ac564e145791daa536e8ee94f97a797a27f"}
   }
  },
  "profile_id": {"const": "urn:odeya:canonicalization:odeya-jcs-0.3"},
  "raw_number_contract_id": {"const": "urn:odeya:canonicalization:raw-number-token-contract:0.1.0"},
  "subject_count_decimal": {"const": "15"},
  "schema_document_subject_count_decimal": {"const": "12"},
  "record_instance_subject_count_decimal": {"const": "3"},
  "subjects": {
   "type": "array",
   "minItems": 15,
   "maxItems": 15,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "role",
     "repository_path",
     "raw_sha256",
     "byte_count_decimal",
     "subject_kind"
    ],
    "properties": {
     "role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
     },
     "repository_path": {
      "type": "string",
      "pattern": "^(schemas|architecture)/[A-Za-z0-9._/-]{1,200}\\.json$"
     },
     "raw_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
     },
     "byte_count_decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,14})$"
     },
     "schema_id": {
      "type": "string",
      "pattern": "^urn:odeya:schema:[a-z][a-z0-9-]{1,80}:(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
     },
     "subject_kind": {
      "enum": ["schema_document", "record_instance"]
     },
     "governing_schema_role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,79}$"
     }
    },
    "if": {
     "properties": {"subject_kind": {"const": "record_instance"}},
     "required": ["subject_kind"]
    },
    "then": {
     "required": ["governing_schema_role"]
    },
    "else": {
     "required": ["schema_id"]
    }
   }
  },
  "closed_schema_vocabulary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "applicator_keywords",
    "assertion_keywords",
    "annotation_keywords",
    "unknown_keyword_disposition"
   ],
   "properties": {
    "applicator_keywords": {
     "type": "array",
     "minItems": 1,
     "maxItems": 40,
     "uniqueItems": true,
     "items": {"type": "string", "minLength": 1, "maxLength": 60}
    },
    "assertion_keywords": {
     "type": "array",
     "minItems": 1,
     "maxItems": 40,
     "uniqueItems": true,
     "items": {"type": "string", "minLength": 1, "maxLength": 60}
    },
    "annotation_keywords": {
     "type": "array",
     "minItems": 1,
     "maxItems": 40,
     "uniqueItems": true,
     "items": {"type": "string", "minLength": 1, "maxLength": 60}
    },
    "unknown_keyword_disposition": {"const": "refuse_not_ignore"}
   }
  },
  "final_position_rule_precedence": {
   "type": "array",
   "minItems": 2,
   "maxItems": 2,
   "prefixItems": [
    {"const": "recursive_integer_valued_const_leaf"},
    {"const": "integer_type"}
   ],
   "items": false
  },
  "schema_document_token_rule": {"const": "schema_definition_data_not_instance_position"},
  "metaschema_evaluation_disposition": {"const": "blocked_out_of_cohort_metaschema_not_retained"},
  "integer_safe_range": {
   "type": "object",
   "additionalProperties": false,
   "required": ["minimum_decimal", "maximum_decimal"],
   "properties": {
    "minimum_decimal": {"const": "-9007199254740991"},
    "maximum_decimal": {"const": "9007199254740991"}
   }
  },
  "refusal_codes": {
   "type": "array",
   "minItems": 21,
   "maxItems": 21,
   "uniqueItems": true,
   "items": {
    "type": "string",
    "pattern": "^[a-z][a-z0-9_]{2,79}$"
   }
  },
  "implementation_requirements": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "source_separated_implementation_count_decimal",
    "third_party_runtime_dependency_count_decimal",
    "private_expectation_consumption_allowed",
    "peer_source_consumption_allowed",
    "peer_result_consumption_allowed",
    "network_access_allowed",
    "environment_path_discovery_allowed",
    "subject_rows_hard_coded_per_implementation"
   ],
   "properties": {
    "source_separated_implementation_count_decimal": {"const": "2"},
    "third_party_runtime_dependency_count_decimal": {"const": "0"},
    "private_expectation_consumption_allowed": {"const": false},
    "peer_source_consumption_allowed": {"const": false},
    "peer_result_consumption_allowed": {"const": false},
    "network_access_allowed": {"const": false},
    "environment_path_discovery_allowed": {"const": false},
    "subject_rows_hard_coded_per_implementation": {"const": true}
   }
  },
  "claim_boundary": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "static_inventory_recomputed_and_compared",
    "metaschema_treatment_settled_as_typed_disposition",
    "per_subject_raw_aware_traces_complete_for_exact_cohort",
    "cross_object_conformance_recomputed_for_exact_cohort",
    "rfc_8785_serialization_conformance_proven",
    "generic_number_semantics_established",
    "out_of_cohort_conformance_established",
    "complete_offline_resolution_proven",
    "organizational_independence_proven",
    "independent_host_reproduction_complete",
    "historical_process_independently_witnessed",
    "product_identity_computed",
    "profile_issued",
    "resource_admitted",
    "prq_002_closed",
    "gate_a_complete",
    "runtime_authorized",
    "publication_authorized"
   ],
   "properties": {
    "static_inventory_recomputed_and_compared": {"const": true},
    "metaschema_treatment_settled_as_typed_disposition": {"const": true},
    "per_subject_raw_aware_traces_complete_for_exact_cohort": {"const": true},
    "cross_object_conformance_recomputed_for_exact_cohort": {"const": true},
    "rfc_8785_serialization_conformance_proven": {"const": false},
    "generic_number_semantics_established": {"const": false},
    "out_of_cohort_conformance_established": {"const": false},
    "complete_offline_resolution_proven": {"const": false},
    "organizational_independence_proven": {"const": false},
    "independent_host_reproduction_complete": {"const": false},
    "historical_process_independently_witnessed": {"const": false},
    "product_identity_computed": {"const": false},
    "profile_issued": {"const": false},
    "resource_admitted": {"const": false},
    "prq_002_closed": {"const": false},
    "gate_a_complete": {"const": false},
    "runtime_authorized": {"const": false},
    "publication_authorized": {"const": false}
   }
  }
 }
}
