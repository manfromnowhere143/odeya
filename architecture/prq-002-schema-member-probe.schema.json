{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:odeya:architecture-schema:prq-002-schema-member-probe:0.1.0",
  "title": "Odeya PRQ-002A Schema Member Identity Probe",
  "description": "Closed architecture-only input for one synthetic schema-member identity probe. A conforming object is test evidence only and cannot be admitted, promoted, or treated as an issued Odeya schema-registry member.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_kind",
    "identity_scope",
    "member_key",
    "schema_bytes",
    "member_digest_contract",
    "member_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_kind": {
      "const": "schema_member_identity_probe"
    },
    "identity_scope": {
      "const": "prq_002_structural_probe_only"
    },
    "member_key": {
      "type": "string",
      "pattern": "^urn:odeya:architecture-schema:[a-z0-9._:-]+@[0-9]+\\.[0-9]+\\.[0-9]+$",
      "maxLength": 255
    },
    "schema_bytes": {
      "$ref": "#/$defs/schema_bytes_identity"
    },
    "member_digest_contract": {
      "$ref": "#/$defs/member_digest_contract"
    },
    "member_digest": {
      "$ref": "#/$defs/digest",
      "x-odeya-digest-scope": {
        "kind": "canonical_object_digest_probe",
        "domain": "odeya-prq-002-schema-member-probe-v1",
        "algorithm": "sha256",
        "profile": "urn:odeya:canonicalization:prq-002-identity-probe-jcs-0.1",
        "status": "test_only_non_issuable"
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "semantic_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "schema_bytes_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "semantic_version",
        "byte_digest",
        "byte_count",
        "media_type",
        "encoding",
        "dialect",
        "root_json_type",
        "retrieval"
      ],
      "properties": {
        "schema_id": {
          "type": "string",
          "pattern": "^urn:odeya:architecture-schema:[a-z0-9._:-]+:[0-9]+\\.[0-9]+\\.[0-9]+$",
          "maxLength": 255
        },
        "semantic_version": {
          "$ref": "#/$defs/semantic_version"
        },
        "byte_digest": {
          "$ref": "#/$defs/digest",
          "x-odeya-digest-scope": {
            "kind": "byte_digest",
            "subject": "exact_retained_schema_resource_bytes",
            "algorithm": "sha256",
            "profile": "not_a_canonical_object_digest",
            "status": "test_only_non_issuable"
          }
        },
        "byte_count": {
          "type": "integer",
          "minimum": 2
        },
        "media_type": {
          "const": "application/schema+json"
        },
        "encoding": {
          "const": "utf-8"
        },
        "dialect": {
          "const": "https://json-schema.org/draft/2020-12/schema"
        },
        "root_json_type": {
          "const": "object"
        },
        "retrieval": {
          "const": "content_addressed_retained_raw_bytes"
        }
      }
    },
    "profile_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "profile_core_schema_id",
        "profile_core_raw_digest"
      ],
      "properties": {
        "profile_id": {
          "const": "urn:odeya:canonicalization:prq-002-identity-probe-jcs-0.1"
        },
        "profile_version": {
          "const": "0.1.0"
        },
        "profile_core_schema_id": {
          "const": "urn:odeya:architecture-schema:prq-002-identity-probe-profile:0.1.0"
        },
        "profile_core_raw_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "subject_schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_id",
        "schema_digest"
      ],
      "properties": {
        "schema_id": {
          "const": "urn:odeya:architecture-schema:prq-002-schema-member-probe:0.1.0"
        },
        "schema_digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "member_digest_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "domain_separator",
        "canonicalization_profile_ref",
        "subject_schema_ref",
        "included_json_pointers",
        "excluded_json_pointers"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "domain_separator": {
          "const": "odeya-prq-002-schema-member-probe-v1"
        },
        "canonicalization_profile_ref": {
          "$ref": "#/$defs/profile_reference"
        },
        "subject_schema_ref": {
          "$ref": "#/$defs/subject_schema_reference"
        },
        "included_json_pointers": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "prefixItems": [
            {
              "const": "/schema_version"
            },
            {
              "const": "/record_kind"
            },
            {
              "const": "/identity_scope"
            },
            {
              "const": "/member_key"
            },
            {
              "const": "/schema_bytes"
            },
            {
              "const": "/member_digest_contract"
            }
          ],
          "items": false
        },
        "excluded_json_pointers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "prefixItems": [
            {
              "const": "/member_digest"
            }
          ],
          "items": false
        }
      }
    }
  },
  "x-odeya-authority-boundary": {
    "identity_status": "test_only_non_issuable",
    "product_schema": false,
    "registry_admission": false,
    "root_binding": false,
    "gate_a_authority": false,
    "runtime_authority": false
  }
}
